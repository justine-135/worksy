generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String          @id                 @default(cuid())
  title         String
  description   String?
  imageUrl      String?         @map("image_url")
  ownerId       String          @map("owner_id")
  ticketCounter Int             @default(0)         @map("ticket_counter") 
  createdAt     DateTime        @default(now())     @map("created_at")
  updatedAt     DateTime        @updatedAt          @map("updated_at")
  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  roles         Role[]
  taskBoards    TaskBoard[]
  invites       ProjectInvite[]
  tasks         Task[]   

  @@map("project")
}

model TaskBoard {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(autoincrement())
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tasks     Task[]
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("task_board")
}

model Task {
  id            String                @id @default(cuid())
  ticketNumber  Int                   @map("ticket_number")
  title         String
  description   String?
  priority      String?
  taskBoardId   String                @map("task_board_id")
  projectId     String                @map("project_id")     
  creatorId     String                @map("creator_id")      
  createdAt     DateTime              @default(now())         @map("created_at")
  updatedAt     DateTime              @updatedAt              @map("updated_at")
  order         Int                   @default(autoincrement())
  taskBoard     TaskBoard             @relation(fields: [taskBoardId], references: [id], onDelete: Cascade)
  assignees     TaskAssignment[]      
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade) 
  createdBy     ProjectMember         @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([projectId, ticketNumber]) 
  @@map("task")
}

model TaskAssignment {
  taskId          String            @map("task_id")
  projectMemberId String            @map("project_member_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  task            Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectMember   ProjectMember     @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)

  @@id([taskId, projectMemberId])
  @@map("task_assignment")
}

model Role {
  id          String          @id @default(cuid())
  name        String
  projectId   String          @map("project_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  permissions Permission[]
  members     ProjectMember[]
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([name, projectId])
  @@map("role")
}

model Permission {
  id          String    @id @default(cuid())
  key         String
  roleId      String    @map("role_id")
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  @@unique([key, roleId])
  @@map("permission")
}

enum ProjectMemberStatus {
  active
  pending
  inactive
}

model ProjectMember {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  projectId         String  @map("project_id")
  roleId            String? @map("role_id")
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role              Role?   @relation(fields: [roleId], references: [id])
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            ProjectMemberStatus  
  taskAssignments   TaskAssignment[]
  createdTasks      Task[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  @@unique([userId, projectId])
  @@map("project_member")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ProjectInvite {
  id            String          @id @default(cuid())
  senderId      String          @map("sender_id")
  receiverId    String          @map("receiver_id")
  projectId     String          @map("project_id")
  status        InviteStatus    @default(PENDING)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userSender    User            @relation("ProjectSender", fields: [senderId], references: [id], onDelete: Cascade)
  userReceiver  User            @relation("ProjectReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  @@map("project_invite")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String?         @unique
  emailVerified   DateTime?       @map("email_verified")
  image           String?
  accounts        Account[]
  ownedProjects   Project[]       @relation("ProjectOwner") 
  memberships     ProjectMember[]
  sessions        Session[]
  sentInvites     ProjectInvite[] @relation("ProjectSender")
  receivedInvites ProjectInvite[] @relation("ProjectReceiver")

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
