generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String          @id                 @default(cuid())
  title         String
  description   String?
  imageUrl      String?         @map("image_url")
  ownerId       String          @map("owner_id")
  defaultTaskPriority String?   @default("medium") @map("default_task_priority")
  ticketCounter Int             @default(0)         @map("ticket_counter")
  createdAt     DateTime        @default(now())     @map("created_at")
  updatedAt     DateTime        @updatedAt          @map("updated_at")
  
  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members       ProjectMember[]
  roles         Role[]
  taskBoards    TaskBoard[]
  invites       ProjectInvite[]
  tasks         Task[]   
  activityLog   ActivityLog[]

  @@map("project")
}

model TaskBoard {
  id                String              @id @default(cuid())
  title             String
  status            TaskStatus          @default(TODO)
  order             Int                 @default(autoincrement())
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  projectId         String              @map("project_id")
  
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  tasks             Task[]
  fromColumnChanges ColumnChangeDetail[] @relation("FromBoard")
  toColumnChanges   ColumnChangeDetail[] @relation("ToBoard")

  @@map("task_board")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id            String                @id @default(cuid())
  ticketNumber  Int                   @map("ticket_number")
  title         String
  description   String?
  priority      String?
  status        TaskStatus            @default(TODO)
  order         Int                   @default(autoincrement())
  createdAt     DateTime              @default(now())         @map("created_at")
  updatedAt     DateTime              @updatedAt              @map("updated_at")

  taskBoardId   String                @map("task_board_id")
  projectId     String                @map("project_id")
  creatorId     String                @map("creator_id")

  assignees     TaskAssignment[]
  activityLog   ActivityLog[]

  taskBoard     TaskBoard             @relation(fields: [taskBoardId], references: [id], onDelete: Cascade)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     ProjectMember         @relation("createdBy", fields: [creatorId], references: [id], onDelete: Cascade)

  // Task hierarchy is a DAG (a task can have many parents AND many children).
  // childLinks  = rows where this task is the parent → its children.
  // parentLinks = rows where this task is the child  → its parents.
  childLinks    TaskRelation[]        @relation("relationParent")
  parentLinks   TaskRelation[]        @relation("relationChild")

  @@unique([projectId, ticketNumber])
  @@map("task")
}

// Directed parent -> child edge between two tasks. The composite PK prevents
// duplicate links; cycle prevention is enforced in the data-access layer.
model TaskRelation {
  parentId  String   @map("parent_id")
  childId   String   @map("child_id")
  createdAt DateTime @default(now()) @map("created_at")

  parent    Task     @relation("relationParent", fields: [parentId], references: [id], onDelete: Cascade)
  child     Task     @relation("relationChild", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@map("task_relation")
}

model TaskAssignment {
  taskId          String            @map("task_id")
  projectMemberId String            @map("project_member_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  task            Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectMember   ProjectMember     @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)

  @@id([taskId, projectMemberId])
  @@map("task_assignment")
}

model Role {
  id          String          @id @default(cuid())
  name        String
  projectId   String          @map("project_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  permissions Permission[]
  members     ProjectMember[]
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([name, projectId])
  @@map("role")
}

model Permission {
  id          String    @id @default(cuid())
  key         String
  roleId      String    @map("role_id")
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  @@unique([key, roleId])
  @@map("permission")
}

enum ProjectMemberStatus {
  active
  pending
  inactive
}

model ProjectMember {
  id                String                @id @default(cuid())
  userId            String                @map("user_id")
  projectId         String                @map("project_id")
  roleId            String?               @map("role_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  lastActivityAt    DateTime?             @map("last_activity_at")
  
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role              Role?                 @relation(fields: [roleId], references: [id])
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status            ProjectMemberStatus  
  taskAssignments   TaskAssignment[]
  createdTasks      Task[]                @relation("createdBy")
  activityLog       ActivityLog[]

  @@unique([userId, projectId])
  @@map("project_member")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ProjectInvite {
  id            String          @id @default(cuid())
  senderId      String          @map("sender_id")
  receiverId    String          @map("receiver_id")
  projectId     String          @map("project_id")
  status        InviteStatus    @default(PENDING)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userSender    User            @relation("ProjectSender", fields: [senderId], references: [id], onDelete: Cascade)
  userReceiver  User            @relation("ProjectReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  @@map("project_invite")
}

enum ActivityType {
  COLUMN_CHANGE   // a task moved between board columns (was STATUS_CHANGE)
  STATUS_CHANGE   // a task's status field (Todo / In Progress / Done) changed
  COMMENT
  TASK_CREATE
  ASSIGNEE_CHANGE
  PARENT_CHANGE   // a task's parent (hierarchy) link was set or changed
  // Add types later like: TASK_EDIT
}

model ActivityLog {
  id              String         @id @default(cuid())
  type            ActivityType
  taskId          String         @map("task_id")
  projectId       String         @map("project_id")
  actorId         String         @map("actor_id") 
  createdAt       DateTime       @default(now()) @map("created_at")
  
  task            Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor           ProjectMember  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  
  // Optional sub-payloads (Only one will be filled depending on the ActivityType)
  columnChange    ColumnChangeDetail?
  statusChange    StatusChangeDetail?
  comment         CommentDetail?

  @@map("activity_log")
}

// Records a task moving between board columns (ActivityType.COLUMN_CHANGE).
model ColumnChangeDetail {
  id              String      @id @default(cuid())
  activityLogId   String      @unique @map("activity_log_id")
  fromBoardId     String      @map("from_board_id")
  toBoardId       String      @map("to_board_id")

  activityLog     ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  fromBoard       TaskBoard   @relation("FromBoard", fields: [fromBoardId], references: [id], onDelete: Cascade)
  toBoard         TaskBoard   @relation("ToBoard", fields: [toBoardId], references: [id], onDelete: Cascade)

  @@map("column_change_detail")
}

// Records a task's status field changing (ActivityType.STATUS_CHANGE).
model StatusChangeDetail {
  id              String      @id @default(cuid())
  activityLogId   String      @unique @map("activity_log_id")
  fromStatus      TaskStatus  @map("from_status")
  toStatus        TaskStatus  @map("to_status")

  activityLog     ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)

  @@map("status_change_detail")
}

model CommentDetail {
  id              String      @id @default(cuid())
  activityLogId   String      @unique @map("activity_log_id")
  value           String
  createdAt       DateTime    @default(now())     @map("created_at")
  updatedAt       DateTime    @updatedAt          @map("updated_at")

  activityLog     ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  @@map("comment_detail")
}

enum NotificationType {
  MENTION
  INVITE
  ASSIGNED
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        NotificationType   
  title       String
  body        String?
  data        Json?    // extra payload (link, entity id, etc.)
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notification")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String?         @unique
  emailVerified   DateTime?       @map("email_verified")
  image           String?
  accounts        Account[]
  ownedProjects   Project[]       @relation("ProjectOwner") 
  memberships     ProjectMember[]
  sessions        Session[]
  sentInvites     ProjectInvite[] @relation("ProjectSender")
  receivedInvites ProjectInvite[] @relation("ProjectReceiver")
  notification    Notification[] 

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
